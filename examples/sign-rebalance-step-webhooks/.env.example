# Tesser Java SDK, examples/sign-rebalance-step-webhooks
#
# Copy this file to `.env.local` (gitignored) and fill in real values:
#   cp .env.example .env.local
#
# Then source it before running the example:
#   set -a && source .env.local && set +a
#   ./gradlew :examples:sign-rebalance-step-webhooks:run
#
# Alternatives: `direnv`, `dotenv-cli`, or IntelliJ run-configuration env vars.

# --- Tesser API ---

# Base URL for the Tesser API (the host that serves /v1/treasury/rebalances).
API_BASE_URL=https://sandbox.tesserx.co

# OAuth token endpoint. NOTE: this is a SEPARATE host from API_BASE_URL.
AUTH_TOKEN_URL=https://dev-awqy75wdabpsnsvu.us.auth0.com/oauth/token

# OAuth audience parameter. Defaults to API_BASE_URL if left blank.
API_AUDIENCE=

# OAuth client_credentials issued by Tesser.
# Get from the Tesser dashboard, under Settings, then API Credentials.
API_CLIENT_ID=
API_CLIENT_SECRET=

# --- Signing key ---
#
# Same format as examples/create-wallet/.env.example. See that file for the
# field-format rules.

SIGNING_PUBLIC_KEY=
SIGNING_PRIVATE_KEY=
SIGNING_ENCLAVE_ID=

# --- Webhook listener ---

# The publicly-reachable URL that points to this example's webhook listener.
# You provide this by running a tunnel:
#   cloudflared tunnel --url http://localhost:8787
# The tunnel command prints the public https://....trycloudflare.com URL.
# Register that URL in the Tesser dashboard for the `step.*` events before
# running this example. The listener accepts POSTs on ANY path, so it does not
# matter whether your tunnel appends one.
#
# Not read by the example -- it is recorded here so the value you registered in
# the dashboard lives next to the rest of the run configuration.
WEBHOOK_PUBLIC_URL=

# Local port the embedded webhook server listens on. Default 8787.
WEBHOOK_PORT=8787

# Webhook signing secret from the Tesser dashboard.
#
# Not read by the example yet: signature verification is deliberately not
# implemented, because the header name and algorithm are not documented in the
# public Tesser docs at the time of writing. Do NOT run this against production
# until that path exists.
WEBHOOK_SECRET=

# --- Rebalance: what to move ---

# Source account. FROM_AMOUNT, FROM_CURRENCY and FROM_NETWORK are optional and
# default to 0.000001 / USDC / BASE_SEPOLIA.
FROM_ACCOUNT_ID=
FROM_AMOUNT=
FROM_CURRENCY=
FROM_NETWORK=

# Destination account. TO_CURRENCY and TO_NETWORK are optional and default to
# USDC / BASE_SEPOLIA.
TO_ACCOUNT_ID=
TO_CURRENCY=
TO_NETWORK=
