# Tesser Java SDK, examples/sign-rebalance-step-polling
#
# Copy this file to `.env.local` (gitignored) and fill in real values:
#   cp .env.example .env.local
#
# Then source it before running the example:
#   set -a && source .env.local && set +a
#   ./gradlew :examples:sign-rebalance-step-polling:run
#
# Alternatives: `direnv`, `dotenv-cli`, or IntelliJ run-configuration env vars.
#
# No tunnel, public URL, or webhook subscription is needed for this variant.

# --- Tesser API ---

# Base URL for the Tesser API (the host that serves /v1/treasury/rebalances).
API_BASE_URL=https://staging.tesser.xyz

# OAuth token endpoint. NOTE: this is a SEPARATE host from API_BASE_URL.
AUTH_TOKEN_URL=https://auth.tesser.xyz/oauth/token

# OAuth audience parameter. Defaults to API_BASE_URL if left blank.
API_AUDIENCE=

# OAuth client_credentials issued by Tesser.
# Get from the Tesser dashboard, under Settings, then API Credentials.
API_CLIENT_ID=
API_CLIENT_SECRET=

# --- Signing key ---
#
# Same format as examples/create-wallet/.env.example. See that file for the
# field-format rules.

SIGNING_PUBLIC_KEY=
SIGNING_PRIVATE_KEY=
SIGNING_ENCLAVE_ID=

# --- Rebalance: what to move ---

# Source account. FROM_AMOUNT, FROM_CURRENCY and FROM_NETWORK are optional and
# default to 0.000001 / USDC / BASE_SEPOLIA.
FROM_ACCOUNT_ID=
FROM_AMOUNT=
FROM_CURRENCY=
FROM_NETWORK=

# Destination account. TO_CURRENCY and TO_NETWORK are optional and default to
# USDC / BASE_SEPOLIA.
TO_ACCOUNT_ID=
TO_CURRENCY=
TO_NETWORK=
