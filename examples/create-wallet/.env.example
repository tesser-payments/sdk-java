# Tesser Java SDK, examples/create-wallet
#
# Copy this file to `.env.local` (gitignored) and fill in real values:
#   cp .env.example .env.local
#
# Then source it before running the example:
#   set -a && source .env.local && set +a
#   ./gradlew :examples:create-wallet:run
#
# Alternatives: `direnv`, `dotenv-cli`, or IntelliJ run-configuration env vars.

# --- Tesser API ---

# Base URL for the Tesser API (the host that serves /v1/accounts/wallets etc.).
# Use the staging or sandbox URL while testing; switch to production when ready.
API_BASE_URL=https://sandbox.tesserx.co

# OAuth token endpoint. NOTE: this is a SEPARATE host from API_BASE_URL. Tesser
# hosts the OAuth /oauth/token endpoint on a dedicated Auth0 tenant. Ask
# Tesser support for the exact URL that matches your environment.
AUTH_TOKEN_URL=https://dev-awqy75wdabpsnsvu.us.auth0.com/oauth/token

# OAuth audience parameter. Defaults to API_BASE_URL if left blank, which is
# what the Tesser auth provider expects in normal use. Override only if Tesser
# support directs you to a different value.
API_AUDIENCE=

# OAuth client_credentials issued by Tesser.
# Get these from the Tesser dashboard, under Settings, then API Credentials.
API_CLIENT_ID=
API_CLIENT_SECRET=

# --- Signing key ---
#
# Issued when you register an API signing key with Tesser. The Tesser dashboard
# surfaces these under Settings, then Signing Keys.
#
# Format rules:
#   - publicKey is the 33-byte COMPRESSED P-256 (secp256r1) point in hex
#       66 hex characters total, prefixed with '02' or '03'.
#       The SDK does NOT auto-compress; supply the canonical form your key was
#       registered with.
#   - privateKey is the raw 32-byte P-256 scalar in hex (64 hex characters).
#   - enclaveId is the Turnkey sub-organization ID of your workspace, a UUID
#     like '3f2b6c1e-...'. The dashboard shows it as SIGNING_ENCLAVE_ID.
#
# All three come from the SAME 'API Key Created' dialog as API_CLIENT_ID and
# API_CLIENT_SECRET (dashboard: Settings, then API Keys, then Create). They
# are only shown once. Do not mix the signing key from one API key with the
# client credentials of another: the API rejects a signed request whose
# enclaveId is not the sub-organization of the workspace that owns the
# client (error accounts-3023).

SIGNING_PUBLIC_KEY=
SIGNING_PRIVATE_KEY=
SIGNING_ENCLAVE_ID=

# --- Wallet to create ---

# One of: stablecoin_ethereum | stablecoin_solana | stablecoin_stellar.
# stablecoin_ethereum is verified end-to-end against Tesser staging.
# Solana and Stellar are not yet verified; use them at your own risk.
CREATE_WALLET_TYPE=stablecoin_ethereum
